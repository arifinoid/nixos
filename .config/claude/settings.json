{
	"env": {
		"ANTHROPIC_AUTH_TOKEN": "__LONGCAT_AUTH_TOKEN_FROM_SOPS__",
		"ANTHROPIC_BASE_URL": "https://api.longcat.ai/anthropic",
		"ANTHROPIC_MODEL": "LongCat-2.5",
		"ANTHROPIC_SMALL_FAST_MODEL": "LongCat-2.5",
		"ANTHROPIC_DEFAULT_SONNET_MODEL": "LongCat-2.5",
		"ANTHROPIC_DEFAULT_OPUS_MODEL": "LongCat-2.5",
		"CLAUDE_CODE_MAX_OUTPUT_TOKENS": "262144",
		"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": 1
	},
	"permissions": {
		"allow": [
			"Bash(rtk *)",
			"Bash(icm *)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git show *)",
			"Bash(git blame *)",
			"Bash(git ls-files *)",
			"Bash(git rev-parse *)",
			"Bash(git fetch *)",
			"Bash(git pull *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git push *)",
			"Bash(git stash *)",
			"Bash(git switch *)",
			"Bash(bun run *)",
			"Bash(bun test *)",
			"Bash(bun build *)",
			"Bash(bun install *)",
			"Bash(bun add *)",
			"Bash(bun remove *)",
			"Bash(bun update *)",
			"Bash(npm run *)",
			"Bash(npm test *)",
			"Bash(npm ci *)",
			"Bash(npm install *)",
			"Bash(npm ls *)",
			"Bash(npm audit *)",
			"Bash(npm outdated *)",
			"Bash(npm view *)",
			"Bash(cargo build *)",
			"Bash(cargo test *)",
			"Bash(cargo check *)",
			"Bash(cargo clippy *)",
			"Bash(cargo fmt *)",
			"Bash(cargo doc *)",
			"Bash(cargo metadata *)",
			"Bash(cargo tree *)",
			"Bash(cargo run *)",
			"Bash(go build *)",
			"Bash(go test *)",
			"Bash(go vet *)",
			"Bash(go fmt *)",
			"Bash(go mod *)",
			"Bash(go run *)",
			"Bash(nix build *)",
			"Bash(nix eval *)",
			"Bash(nix fmt *)",
			"Bash(nix flake check *)",
			"Bash(nix flake metadata *)",
			"Bash(nix flake update *)",
			"Bash(nix-build *)",
			"Bash(nixos-rebuild build *)",
			"Bash(gh pr *)",
			"Bash(gh issue *)",
			"Bash(gh repo view *)",
			"Bash(gh auth status)"
		],
		"ask": [
			"Bash(sudo *)",
			"Bash(sops *)",
			"Bash(curl *)",
			"Bash(wget *)",
			"Bash(npx *)",
			"Bash(bunx *)",
			"Bash(cargo install *)",
			"Bash(cargo publish *)",
			"Bash(npm publish *)",
			"Bash(bun publish *)",
			"Bash(nixos-rebuild switch *)",
			"Bash(nixos-rebuild boot *)",
			"Bash(home-manager switch *)",
			"Bash(git checkout *)",
			"Bash(git restore *)",
			"Bash(git reset *)",
			"Bash(git clean *)",
			"Bash(git branch *)"
		],
		"deny": [
			"Bash(git push --force*)",
			"Bash(git push --force-with-lease*)",
			"Bash(git push -f*)",
			"Bash(rtk git push --force*)",
			"Bash(rtk git push -f*)",
			"Bash(git reset --hard *)",
			"Bash(git clean -f*)",
			"Bash(git branch -D*)",
			"Bash(rm -rf /*)",
			"Bash(rm -rf ~*)",
			"Read(.env)",
			"Read(.env.*)",
			"Read(secrets/**)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/id_rsa*)",
			"Read(**/id_ed25519*)",
			"Read(~/.ssh/**)",
			"Read(~/.gnupg/**)",
			"Read(~/.config/sops/**)",
			"Read(//var/lib/sops-nix/**)",
			"Edit(.env)",
			"Edit(.env.*)",
			"Edit(secrets/**)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "rtk hook claude"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/arifinoid/.local/bin/icm hook pre"
					}
				],
				"matcher": "Bash"
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/arifinoid/.local/bin/icm hook post"
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/arifinoid/.local/bin/icm hook compact"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/arifinoid/.local/bin/icm hook prompt"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/arifinoid/.local/bin/icm hook start"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/arifinoid/.local/bin/icm hook end"
					}
				]
			}
		]
	}
}
